        f"Ожидался один CSP-конфиг Remnawave, найдено: {len(csp_candidates)}"
    )

csp_path, csp = csp_candidates[0]
if "XRAY_EDITOR_URL" not in csp or "'frame-src'" not in csp:
    anchor = "directives: {"
    if anchor not in csp:
        raise SystemExit(f"Не найден directives anchor в {csp_path}")
    csp = csp.replace(
        anchor,
        anchor
        + "\n                    'frame-src': [\"'self'\", process.env.XRAY_EDITOR_URL!],",
        1,
    )
    csp_path.write_text(csp, encoding="utf-8")


dockerfile = (backend / "Dockerfile").read_text(encoding="utf-8")
match = re.search(r"^FROM node:[^\n]+ AS backend-build$", dockerfile, re.MULTILINE)
if not match:
    raise SystemExit("Не найден backend-build stage в Dockerfile")
marker = match.group(0)
_, rest = dockerfile.split(marker, 1)

frontend_stage = r'''FROM alpine:3.19 AS frontend
WORKDIR /opt/frontend

ARG BRANCH=main
COPY patched-frontend-dist ./frontend_temp/dist
RUN apk add --no-cache curl ca-certificates \
    && mkdir -p frontend_temp/dist/assets \
    && curl -fL https://validator.remna.dev/wasm_exec.js -o frontend_temp/dist/assets/wasm_exec.js \
    && curl -fL https://validator.remna.dev/xray.schema.json -o frontend_temp/dist/assets/xray.schema.json \
    && curl -fL https://validator.remna.dev/xray.schema.cn.json -o frontend_temp/dist/assets/xray.schema.cn.json \
    && curl -fL https://validator.remna.dev/main.wasm -o frontend_temp/dist/assets/main.wasm
'''

(backend / "Dockerfile.editor-iframe").write_text(
    frontend_stage + marker + rest,
    encoding="utf-8",
)

print("Remnawave iframe patch applied")
PY
}



github_api_get() {
    local repo="$1" endpoint="$2" destination="$3"
    local -a headers
    headers=(
        -H 'Accept: application/vnd.github+json'
        -H 'X-GitHub-Api-Version: 2022-11-28'
        -H 'User-Agent: rw-wasm-replacer'
    )
    [[ -n "${GITHUB_TOKEN:-}" ]] && headers+=(-H "Authorization: Bearer ${GITHUB_TOKEN}")
    curl -fsSL --connect-timeout 8 --max-time 20 --retry 2 "${headers[@]}" \
        "https://api.github.com/repos/${repo}/${endpoint}" -o "$destination"
}

github_release() {
    github_api_get "$1" 'releases/latest' "$2"
}

github_latest_tag() {
    local repo="$1" destination="$2" tags_file code
    tags_file="$(mktemp)"

    if ! github_api_get "$repo" 'tags?per_page=100' "$tags_file"; then
        rm -f "$tags_file"
        return 1
    fi

    TAGS_FILE="$tags_file" python3 <<'PY_TAGS' > "$destination"
import json
import os
import re

try:
    with open(os.environ["TAGS_FILE"], encoding="utf-8") as handle:
        tags = json.load(handle)
except Exception:
    raise SystemExit(1)

versions = []
for item in tags:
    name = str(item.get("name", ""))
    match = re.fullmatch(r"v?(\d+)\.(\d+)\.(\d+)", name)
    if match:
        versions.append((tuple(map(int, match.groups())), name))

if not versions:
    raise SystemExit(1)

_, name = max(versions)
print(name, end="")
PY_TAGS
    code=$?
    rm -f "$tags_file"
    return "$code"
}

release_field() {
    local file="$1" field="$2"
    RELEASE_FILE="$file" RELEASE_FIELD="$field" python3 <<'PY'
import json
import os

try:
    with open(os.environ["RELEASE_FILE"], encoding="utf-8") as handle:
        data = json.load(handle)
except Exception:
    raise SystemExit(0)

value = data.get(os.environ["RELEASE_FIELD"], "")
if value is None:
    value = ""
print(value, end="")
PY
}

release_asset_url() {
    local file="$1" name="$2"
    RELEASE_FILE="$file" ASSET_NAME="$name" python3 <<'PY'
import json
import os

try:
    with open(os.environ["RELEASE_FILE"], encoding="utf-8") as handle:
        data = json.load(handle)
except Exception:
    raise SystemExit(0)

for asset in data.get("assets", []):
    if asset.get("name") == os.environ["ASSET_NAME"]:
        print(asset.get("browser_download_url", ""), end="")
        break
PY
}

