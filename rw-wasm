#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_VERSION="1.0.1"
SCRIPT_NAME="Remnawawe WASM Replacer by CapyTeam"
SCRIPT_REPO="CapyTeam/rw-wasm-replacer"
PANEL_BACKEND_REPO="remnawave/backend"
PANEL_FRONTEND_REPO="remnawave/frontend"
EDITOR_REPO="VAQYBIN/Remnawave-Xray-UI-Editor"

# Correct UTF-8 width for the colored terminal menu.
if command -v locale >/dev/null 2>&1; then
    if locale -a 2>/dev/null | grep -qi '^C\.utf8$'; then
        export LC_ALL=C.utf8
    elif locale -a 2>/dev/null | grep -qi '^C\.UTF-8$'; then
        export LC_ALL=C.UTF-8
    fi
fi

STATE_ROOT="${RW_WASM_STATE_ROOT:-/var/lib/rw-wasm-replacer}"
CACHE_ROOT="${RW_WASM_CACHE_ROOT:-/var/cache/rw-wasm-replacer}"
BUILD_ROOT="${RW_WASM_BUILD_ROOT:-/opt/rw-wasm-replacer/build}"
BACKUP_ROOT="$STATE_ROOT/backups"
LOCK_FILE="${RW_WASM_LOCK_FILE:-/var/lock/rw-wasm-replacer.lock}"
LOG_FILE="${RW_WASM_LOG_FILE:-/var/log/rw-wasm-replacer.log}"

PANEL_CONTAINER_DEFAULT="remnawave"
EDITOR_CONTAINER_DEFAULT="remnawave-xray-ui-editor"
PANEL_DIR_DEFAULT="/opt/remnawave"
EDITOR_DIR_DEFAULT="/opt/remnawave-xray-ui-editor"
LABEL_NS="io.capyteam.rw-wasm-replacer"

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    RESET=$'\033[0m'; BOLD=$'\033[1m'; DIM=$'\033[2m'
    RED=$'\033[1;31m'; GREEN=$'\033[1;32m'; YELLOW=$'\033[1;33m'
    BLUE=$'\033[1;34m'; MAGENTA=$'\033[1;35m'; CYAN=$'\033[1;36m'
    WHITE=$'\033[1;37m'; GRAY=$'\033[0;90m'
else
    RESET=''; BOLD=''; DIM=''; RED=''; GREEN=''; YELLOW=''
    BLUE=''; MAGENTA=''; CYAN=''; WHITE=''; GRAY=''
fi

log()  { printf '%b[INFO]%b %s\n' "$BLUE" "$RESET" "$*" | tee -a "$LOG_FILE"; }
ok()   { printf '%b[ OK ]%b %s\n' "$GREEN" "$RESET" "$*" | tee -a "$LOG_FILE"; }
warn() { printf '%b[WARN]%b %s\n' "$YELLOW" "$RESET" "$*" | tee -a "$LOG_FILE" >&2; }
err()  { printf '%b[ERR ]%b %s\n' "$RED" "$RESET" "$*" | tee -a "$LOG_FILE" >&2; }
die()  { err "$*"; exit 1; }

on_error() {
    local code=$? line=${BASH_LINENO[0]:-?}
    err "Сбой на строке $line (код $code). База данных и Docker volumes не удалялись."
    exit "$code"
}
trap on_error ERR

require_root() {
    [[ ${EUID:-$(id -u)} -eq 0 ]] || die "Запустите rw-wasm от root."
}

init_runtime() {
    mkdir -p "$STATE_ROOT" "$CACHE_ROOT" "$BUILD_ROOT" "$BACKUP_ROOT" \
        "$(dirname "$LOCK_FILE")" "$(dirname "$LOG_FILE")"
    touch "$LOG_FILE"
    chmod 700 "$STATE_ROOT" "$BACKUP_ROOT" || true
    chmod 600 "$LOG_FILE" || true
    if command -v flock >/dev/null 2>&1; then
        exec 9>"$LOCK_FILE"
        flock -n 9 || die "Другой экземпляр rw-wasm уже выполняется."
    fi
}

require_tools() {
    local missing=() cmd
    for cmd in docker curl tar python3 awk sed grep sort install mktemp sha256sum; do
        command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
    done
    ((${#missing[@]} == 0)) || die "Не установлены команды: ${missing[*]}"
    docker compose version >/dev/null 2>&1 || die "Не найден Docker Compose plugin."
}

pause() {
    printf '\n%bНажмите Enter, чтобы вернуться в меню…%b' "$DIM" "$RESET"
    read -r _ || true
}

confirm_yn() {
    local prompt="$1" answer
    while true; do
        printf '%b%s [Y/N]: %b' "$BOLD" "$prompt" "$RESET"
        read -r answer || return 1
        case "${answer,,}" in
            y|yes|д|да) return 0 ;;
            n|no|н|нет) return 1 ;;
            *) warn "Введите только Y или N." ;;
        esac
    done
}

prompt_value() {
    local prompt="$1" default="${2:-}" value
    if [[ -n "$default" ]]; then
        printf '%b%s%b [%s]: ' "$BOLD" "$prompt" "$RESET" "$default" >&2
    else
        printf '%b%s%b: ' "$BOLD" "$prompt" "$RESET" >&2
    fi
    read -r value
    printf '%s\n' "${value:-$default}"
}

prompt_secret() {
    local prompt="$1" value
    printf '%b%s%b: ' "$BOLD" "$prompt" "$RESET" >&2
    read -r -s value
    printf '\n' >&2
    printf '%s' "$value"
}

normalize_version() {
    printf '%s\n' "${1#v}"
}

version_gt() {
    local a b
    a="$(normalize_version "$1")"; b="$(normalize_version "$2")"
    [[ "$a" != "$b" && "$(printf '%s\n%s\n' "$a" "$b" | sort -V | tail -n1)" == "$a" ]]
}

container_exists() {
    docker inspect "$1" >/dev/null 2>&1
}

find_container_exact() {
    local preferred="$1" pattern="$2"
    if container_exists "$preferred"; then
        printf '%s\n' "$preferred"
        return 0
    fi
    docker ps -a --format '{{.Names}}' | grep -E "$pattern" | head -n1 || true
}

inspect_label() {
    local container="$1" label="$2"
    docker inspect "$container" --format "{{ index .Config.Labels \"$label\" }}" 2>/dev/null || true
}

image_label() {
    local image="$1" label="$2"
    docker image inspect "$image" --format "{{ index .Config.Labels \"$label\" }}" 2>/dev/null || true
}

find_working_dir() {
    local container="$1" fallback="$2" value
    value="$(inspect_label "$container" 'com.docker.compose.project.working_dir')"
    [[ -n "$value" && "$value" != '<no value>' ]] || value="$fallback"
    printf '%s\n' "$value"
}

find_service_name() {
    local container="$1" fallback="$2" value
    value="$(inspect_label "$container" 'com.docker.compose.service')"
    [[ -n "$value" && "$value" != '<no value>' ]] || value="$fallback"
    printf '%s\n' "$value"
}

find_compose_file() {
    local container="$1" fallback_dir="$2" working files candidate
    working="$(find_working_dir "$container" "$fallback_dir")"
    files="$(inspect_label "$container" 'com.docker.compose.project.config_files')"

    if [[ -n "$files" && "$files" != '<no value>' ]]; then
        while IFS= read -r candidate; do
            [[ -n "$candidate" ]] || continue
            [[ "$candidate" = /* ]] || candidate="$working/$candidate"
            [[ -f "$candidate" ]] && { printf '%s\n' "$candidate"; return 0; }
        done < <(printf '%s' "$files" | tr ',' '\n')
    fi

    for candidate in "$working/docker-compose.yml" "$working/docker-compose.yaml"; do
        [[ -f "$candidate" ]] && { printf '%s\n' "$candidate"; return 0; }
    done
    return 1
}

container_env() {
    local container="$1" key="$2"
    docker inspect "$container" --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null \
        | awk -F= -v key="$key" '$1==key {sub(/^[^=]*=/, ""); print; exit}'
}

read_dotenv() {
    local file="$1" key="$2"
    DOTENV_FILE="$file" DOTENV_KEY="$key" python3 <<'PY'
from pathlib import Path
import os
path = Path(os.environ["DOTENV_FILE"])
key = os.environ["DOTENV_KEY"]
if path.exists():
    for line in path.read_text(encoding="utf-8").splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#") or "=" not in stripped:
            continue
        current, value = stripped.split("=", 1)
        if current == key:
            print(value.strip().strip("'\""), end="")
            break
PY
}

write_dotenv() {
    local file="$1" key="$2" value="$3"
    DOTENV_FILE="$file" DOTENV_KEY="$key" DOTENV_VALUE="$value" python3 <<'PY'
from pathlib import Path
import os
path = Path(os.environ["DOTENV_FILE"])
key = os.environ["DOTENV_KEY"]
value = os.environ["DOTENV_VALUE"]
if "\n" in value or "\r" in value or "'" in value:
    raise SystemExit(f"Недопустимое значение {key}")
lines = path.read_text(encoding="utf-8").splitlines() if path.exists() else []
result = []
done = False
for line in lines:
    if line.lstrip().startswith(key + "="):
        if not done:
            result.append(f"{key}='{value}'")
            done = True
    else:
        result.append(line)
if not done:
    if result and result[-1] != "":
        result.append("")
    result.append("# Remnawawe WASM Replacer by CapyTeam")
    result.append(f"{key}='{value}'")
path.write_text("\n".join(result) + "\n", encoding="utf-8")
PY
    chmod 600 "$file" || true
}

replace_service_image() {
    local compose_file="$1" service="$2" image="$3"
    COMPOSE_FILE="$compose_file" COMPOSE_SERVICE="$service" COMPOSE_IMAGE="$image" python3 <<'PY'
from pathlib import Path
import os
import re

path = Path(os.environ["COMPOSE_FILE"])
service = os.environ["COMPOSE_SERVICE"]
image = os.environ["COMPOSE_IMAGE"]
lines = path.read_text(encoding="utf-8").splitlines()

start = None
service_indent = None
pattern = re.compile(rf"^(?P<indent>\s*){re.escape(service)}:\s*(?:#.*)?$")
for index, line in enumerate(lines):
    match = pattern.match(line)
    if match:
        start = index
        service_indent = len(match.group("indent"))
        break
if start is None:
    raise SystemExit(f"Сервис {service} не найден в {path}")

end = len(lines)
for index in range(start + 1, len(lines)):
    raw = lines[index]
    if not raw.strip() or raw.lstrip().startswith("#"):
        continue
    if len(raw) - len(raw.lstrip()) <= service_indent:
        end = index
        break

child_indent = " " * (service_indent + 2)
for index in range(start + 1, end):
    if re.match(r"^\s*image\s*:", lines[index]):
        lines[index] = f"{child_indent}image: {image}"
        break
else:
    lines.insert(start + 1, f"{child_indent}image: {image}")

path.write_text("\n".join(lines) + "\n", encoding="utf-8")
PY
}

state_file() {
    printf '%s/%s.env\n' "$STATE_ROOT" "$1"
}

save_state() {
    local component="$1"
    shift
    local file tmp key value
    file="$(state_file "$component")"
    tmp="${file}.tmp"
    : > "$tmp"
    printf 'STATE_FORMAT=%q\n' 1 >> "$tmp"
    while (($#)); do
        key="$1"; value="$2"; shift 2
        printf '%s=%q\n' "$key" "$value" >> "$tmp"
    done
    chmod 600 "$tmp"
    mv -f "$tmp" "$file"
}

load_state() {
    local component="$1" file
    file="$(state_file "$component")"
    [[ -f "$file" ]] || return 1
    # shellcheck disable=SC1090
    source "$file"
}

archive_state() {
    local component="$1" file destination
    file="$(state_file "$component")"
    [[ -f "$file" ]] || return 0
    destination="$BACKUP_ROOT/state-${component}-$(date +%Y%m%d-%H%M%S).env"
    cp -a "$file" "$destination"
    rm -f "$file"
}

backup_current_image() {
    local component="$1" container="$2" timestamp image_id tag
    timestamp="$(date +%Y%m%d%H%M%S)"
    image_id="$(docker inspect "$container" --format '{{.Image}}')"
    tag="local/capyteam/rw-wasm-backup/${component}:${timestamp}"
    docker image tag "$image_id" "$tag"
    printf '%s\n' "$tag"
}

panel_version() {
    local container="$1" version image
    version="$(container_env "$container" '__RW_METADATA_VERSION')"
    if [[ -z "$version" ]]; then
        image="$(docker inspect "$container" --format '{{.Config.Image}}' 2>/dev/null || true)"
        version="$(printf '%s' "$image" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | tail -n1 || true)"
    fi
    printf '%s\n' "${version:-неизвестна}"
}

editor_version() {
    local container="$1" version image
    image="$(docker inspect "$container" --format '{{.Config.Image}}' 2>/dev/null || true)"
    version="$(image_label "$image" "$LABEL_NS.upstream-version")"

    if [[ -z "$version" ]]; then
        version="$(docker exec "$container" sh -lc '
            node -e "
                const fs=require(\"fs\");
                for (const p of [\"/app/package.json\",\"/app/backend/package.json\"]) {
                    try {
                        const v=JSON.parse(fs.readFileSync(p,\"utf8\")).version;
                        if (v) { process.stdout.write(v); process.exit(0); }
                    } catch {}
                }
            "
        ' 2>/dev/null || true)"
    fi

    if [[ -z "$version" ]]; then
        version="$(printf '%s' "$image" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1 || true)"
    fi

    if [[ -z "$version" ]] && load_state editor 2>/dev/null; then
        version="${UPSTREAM_VERSION:-}"
    fi

    printf '%s\n' "${version:-неизвестна}"
}

component_patch_version() {
    local container="$1" image value
    [[ -n "$container" ]] || return 0
    image="$(docker inspect "$container" --format '{{.Config.Image}}' 2>/dev/null || true)"
    value="$(image_label "$image" "$LABEL_NS.patch-version")"
    if [[ -z "$value" && "$image" =~ (editor-sso|iframe-sso|editor-iframe|wasm) ]]; then
        value="legacy"
    fi
    printf '%s\n' "$value"
}

wait_healthy() {
    local container="$1" timeout="${2:-300}" started status health
    started="$(date +%s)"
    while true; do
        status="$(docker inspect "$container" --format '{{.State.Status}}' 2>/dev/null || true)"
        health="$(docker inspect "$container" --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' 2>/dev/null || true)"
        if [[ "$status" == "running" && ( "$health" == "healthy" || "$health" == "none" ) ]]; then
            return 0
        fi
        if (( $(date +%s) - started >= timeout )); then
            docker logs --tail=200 "$container" >&2 || true
            die "$container не стал healthy (status=$status, health=$health)."
        fi
        sleep 3
    done
}

restart_reverse_proxy() {
    local proxy
    for proxy in remnawave-nginx nginx caddy; do
        if container_exists "$proxy"; then
            docker restart "$proxy" >/dev/null || true
            sleep 3
            return 0
        fi
    done
}

source_tag_download() {
    local repo="$1" version="$2" destination="$3" tag archive
    for tag in "$version" "v$version"; do
        rm -rf "$destination"
        mkdir -p "$destination"
        archive="$(mktemp)"
        if curl -fsSL --connect-timeout 10 --max-time 180 --retry 3 \
            "https://codeload.github.com/${repo}/tar.gz/refs/tags/${tag}" -o "$archive" \
            && tar -xzf "$archive" --strip-components=1 -C "$destination"; then
            rm -f "$archive"
            return 0
        fi
        rm -f "$archive"
    done
    return 1
}

download_panel_sources() {
    local version="$1" root="$2"
    log "Загружаю Remnawave frontend/backend $version…"
    source_tag_download "$PANEL_FRONTEND_REPO" "$version" "$root/frontend" \
        || die "Не удалось загрузить frontend $version."
    source_tag_download "$PANEL_BACKEND_REPO" "$version" "$root/backend" \
        || die "Не удалось загрузить backend $version."
}

download_editor_source() {
    local version="$1" destination="$2"
    log "Загружаю Xray UI Editor $version…"
    source_tag_download "$EDITOR_REPO" "$version" "$destination" \
        || die "Не удалось загрузить Editor $version."
}

