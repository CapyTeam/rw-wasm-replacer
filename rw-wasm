patch_status_text() {
    local parts=()

    if [[ -n "$PANEL_CONTAINER" ]]; then
        if [[ -n "$PANEL_PATCH_VERSION" ]]; then
            parts+=("Remnawave: установлен")
        else
            parts+=("Remnawave: не установлен")
        fi
    fi

    if [[ -n "$EDITOR_CONTAINER" ]]; then
        if [[ -n "$EDITOR_PATCH_VERSION" ]]; then
            parts+=("Editor: установлен")
        else
            parts+=("Editor: не установлен")
        fi
    fi

    if ((${#parts[@]} == 0)); then
        printf 'компоненты не найдены'
        return
    fi

    local joined=""
    local part
    for part in "${parts[@]}"; do
        [[ -n "$joined" ]] && joined+="; "
        joined+="$part"
    done
    printf '%s' "$joined"
}

installed_patch_text() {
    local parts=()

    [[ -n "$PANEL_PATCH_VERSION" ]] && parts+=("Remnawave $PANEL_PATCH_VERSION")
    [[ -n "$EDITOR_PATCH_VERSION" ]] && parts+=("Editor $EDITOR_PATCH_VERSION")

    if ((${#parts[@]} == 0)); then
        printf '—'
        return
    fi

    local joined=""
    local part
    for part in "${parts[@]}"; do
        [[ -n "$joined" ]] && joined+=", "
        joined+="$part"
    done
    printf '%s' "$joined"
}

print_header() {
    clear 2>/dev/null || true

    local width=78
    local border title_length left right
    printf -v border '%*s' "$width" ''
    border="${border// /═}"
    title_length=${#SCRIPT_NAME}
    left=$(( (width - title_length) / 2 ))
    right=$(( width - title_length - left ))

    printf '%b╔%s╗%b\n' "$CYAN$BOLD" "$border" "$RESET"
    printf '%b║%*s%b%s%b%*s║%b\n' \
        "$CYAN$BOLD" "$left" '' "$WHITE$BOLD" "$SCRIPT_NAME" \
        "$CYAN$BOLD" "$right" '' "$RESET"
    printf '%b╚%s╝%b\n\n' "$CYAN$BOLD" "$border" "$RESET"

    printf '  %-33s %b%s%b' "Версия скрипта:" "$WHITE$BOLD" "$SCRIPT_VERSION" "$RESET"
    if ((SCRIPT_UPDATE_AVAILABLE)); then
        printf '  %bДОСТУПНО ОБНОВЛЕНИЕ! [v%s]%b' \
            "$YELLOW" "$SCRIPT_LATEST_VERSION" "$RESET"
    fi
    printf '\n'

    printf '  %-33s %s\n' "Версия Remnawawe:" "$PANEL_VERSION"
    printf '  %-33s %s\n' "Версия Xray UI Editor:" "$EDITOR_VERSION"
    printf '  %-33s %s\n' "Статус патча:" "$(patch_status_text)"
    printf '  %-33s %s\n' "Версия установленного патча:" "$(installed_patch_text)"

    if ((PANEL_UPDATE_AVAILABLE)); then
        if ((PANEL_LATEST_COMPATIBLE)); then
            printf '  %bДОСТУПНО ОБНОВЛЕНИЕ С ПАТЧЕМ! [v%s]%b\n' \
                "$GREEN" "$PANEL_LATEST_VERSION" "$RESET"
        else
            printf '  %bДОСТУПНО ОБНОВЛЕНИЕ, ТЕКУЩИЙ ПАТЧ НЕ ПОДДЕРЖИВАЕТСЯ! [v%s]%b\n' \
                "$RED" "$PANEL_LATEST_VERSION" "$RESET"
        fi
    fi

    printf '\n'
}

