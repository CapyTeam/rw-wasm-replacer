    Body,
    Controller,
    HttpException,
    HttpStatus,
    Post,
    UseFilters,
    UseGuards,
} from '@nestjs/common';
import { ApiBearerAuth, ApiTags } from '@nestjs/swagger';

import { Roles } from '@common/decorators/roles/roles';
import { HttpExceptionFilter } from '@common/exception/http-exception.filter';
import { JwtDefaultGuard } from '@common/guards/jwt-guards/def-jwt-guard';
import { RolesGuard } from '@common/guards/roles';
import { ROLE } from '@libs/contracts/constants';

const PROFILE_UUID_RE =
    /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

interface EmbedEditorBody {
    profileUuid?: string;
}

interface EditorTokenResponse {
    token?: unknown;
    message?: unknown;
}

@ApiBearerAuth('Authorization')
@ApiTags('Embedded Xray Editor SSO')
@Roles(ROLE.ADMIN)
@UseGuards(JwtDefaultGuard, RolesGuard)
@UseFilters(HttpExceptionFilter)
@Controller('editor-sso')
export class EditorSsoController {
    @Post('embed')
    async createEmbedUrl(
        @Body() body: EmbedEditorBody,
    ): Promise<{ embedUrl: string; openUrl: string }> {
        const profileUuid = body.profileUuid?.trim();
        if (!profileUuid || !PROFILE_UUID_RE.test(profileUuid)) {
            throw new HttpException('Некорректный UUID профиля', HttpStatus.BAD_REQUEST);
        }

        const editorUrlRaw = process.env.XRAY_EDITOR_URL?.trim();
        const editorPassword = process.env.XRAY_EDITOR_PASSWORD;
        if (!editorUrlRaw || !editorPassword) {
            throw new HttpException(
                'XRAY_EDITOR_URL или XRAY_EDITOR_PASSWORD не настроены',
                HttpStatus.SERVICE_UNAVAILABLE,
            );
        }

        let editorUrl: URL;
        try {
            editorUrl = new URL(editorUrlRaw);
        } catch {
            throw new HttpException('XRAY_EDITOR_URL некорректен', HttpStatus.SERVICE_UNAVAILABLE);
        }
        if (editorUrl.protocol !== 'https:') {
            throw new HttpException(
                'XRAY_EDITOR_URL должен использовать HTTPS',
                HttpStatus.SERVICE_UNAVAILABLE,
            );
        }

        editorUrl.pathname = editorUrl.pathname.replace(/\/+$/, '');
        editorUrl.search = '';
        editorUrl.hash = '';
        const baseUrl = editorUrl.toString().replace(/\/+$/, '');
        const profilePath = `/profiles/${profileUuid}`;

        let response: Response;
        try {
            response = await fetch(`${baseUrl}/api/auth/sso/token`, {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify({
                    password: editorPassword,
                    next: profilePath,
                }),
                signal: AbortSignal.timeout(10_000),
            });
        } catch {
            throw new HttpException('Внешний редактор недоступен', HttpStatus.BAD_GATEWAY);
        }

        const payload = (await response.json().catch(() => null)) as EditorTokenResponse | null;
        if (!response.ok || typeof payload?.token !== 'string') {
            const details = typeof payload?.message === 'string' ? `: ${payload.message}` : '';
            throw new HttpException(
                `Editor отклонил SSO-запрос${details}`,
                HttpStatus.BAD_GATEWAY,
            );
        }

        return {
            embedUrl: `${baseUrl}/api/auth/sso/consume?token=${encodeURIComponent(payload.token)}`,
            openUrl: `${baseUrl}${profilePath}`,
        };
    }
}
