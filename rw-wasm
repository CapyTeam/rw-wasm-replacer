    mapping="$(docker port "$container" 3000/tcp 2>/dev/null | head -n1 || true)"
    [[ -n "$mapping" ]] || return 1
    port="${mapping##*:}"
    [[ "$port" =~ ^[0-9]+$ ]] || return 1
    printf 'http://127.0.0.1:%s\n' "$port"
}

validate_editor_login() {
