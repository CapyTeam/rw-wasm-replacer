check_frame_headers() {
    local child_url="$1" parent_origin="$2" headers
    headers="$(curl -skD- -o /dev/null \
        --connect-timeout 10 --max-time 30 "$child_url/" || true)"

    if printf '%s\n' "$headers" \
        | grep -i '^x-frame-options:' \
        | grep -Eqi '(deny|sameorigin)'; then
        warn "Reverse proxy $child_url отдаёт X-Frame-Options, который может блокировать iframe."
        return 1
    fi

    if ! printf '%s\n' "$headers" \
        | grep -i '^content-security-policy:' \
        | grep -Fq "$parent_origin"; then
        warn "CSP $child_url не разрешает frame-ancestors $parent_origin. Возможно, reverse proxy заменяет заголовок приложения."
        return 1
    fi

    return 0
}

install_editor_patch() {
    local panel_origin="${1:-}"
    local password="${2:-}"
    local version dir compose service env_file current backup image source local_url

    [[ -n "$EDITOR_CONTAINER" ]] || die "Xray UI Editor не найден."
    [[ -z "$EDITOR_PATCH_VERSION" ]] || die "Xray UI Editor уже пропатчен."

    version="$EDITOR_VERSION"
    if [[ "$version" == "неизвестна" || "$version" == "не найден" ]]; then
        version="${EDITOR_LATEST_VERSION:-1.2.0}"
        version="$(prompt_value "Версия Xray UI Editor для сборки" "$version")"
    fi

    log "Проверяю совместимость Editor $version…"
    check_patch_compatibility_editor "$version" \
        || die "Xray UI Editor $version несовместим с патчем $SCRIPT_VERSION."

    if [[ -z "$panel_origin" ]]; then
        panel_origin="$(prompt_value \
            "HTTPS origin панели Remnawave" \
            "https://panel.example.com")"
    fi
    panel_origin="$(validate_url_origin "$panel_origin")" \
        || die "Нужен origin вида https://panel.example.com без пути."

    if [[ -z "$password" ]]; then
        password="$(prompt_secret "APP_PASSWORD Xray UI Editor")"
    fi
    [[ -n "$password" ]] || die "Пароль пуст."

    local_url="$(editor_local_url "$EDITOR_CONTAINER" || true)"
    if [[ -n "$local_url" ]]; then
        validate_editor_login "$local_url" "$password" \
            || die "APP_PASSWORD не принят текущим Xray UI Editor."
    else
        warn "Публичный host-port Editor не найден; пароль будет проверен после установки с сервера Remnawave."
    fi

    dir="$(find_working_dir "$EDITOR_CONTAINER" "$EDITOR_DIR_DEFAULT")"
    compose="$(find_compose_file "$EDITOR_CONTAINER" "$dir")" \
        || die "Compose Xray UI Editor не найден."
    service="$(find_service_name "$EDITOR_CONTAINER" remnawave-xray-ui-editor)"
    env_file="$dir/.env"
    [[ -f "$env_file" ]] || die "Не найден $env_file"

    current="$(docker inspect "$EDITOR_CONTAINER" --format '{{.Config.Image}}')"
    backup="$(backup_current_image editor "$EDITOR_CONTAINER")"
    image="local/capyteam/rw-wasm-editor:${version}-patch-${SCRIPT_VERSION}"
    source="$BUILD_ROOT/editor-$version"

    download_editor_source "$version" "$source"
    build_editor_image "$version" "$source" "$image"

    save_state editor \
        PATCHED 1 \
        PATCH_VERSION "$SCRIPT_VERSION" \
        UPSTREAM_VERSION "$version" \
        ORIGINAL_IMAGE "$current" \
        BACKUP_IMAGE "$backup" \
        PATCH_IMAGE "$image" \
        COMPOSE_FILE "$compose" \
        WORKING_DIR "$dir" \
        SERVICE "$service" \
        PANEL_ORIGIN "$panel_origin"

    write_dotenv "$env_file" XRAY_EDITOR_FRAME_ANCESTOR "$panel_origin"
    replace_service_image "$compose" "$service" "$image"

    (
        cd "$dir"
        docker compose config >/dev/null
        docker compose up -d --force-recreate "$service"
    )

    wait_healthy "$EDITOR_CONTAINER" 240

    local_url="$(editor_local_url "$EDITOR_CONTAINER" || true)"
    if [[ -n "$local_url" ]]; then
        validate_editor_sso "$local_url" "$password" \
            || die "Patched Editor запущен, но локальная SSO-проверка не прошла. Используйте меню отката."
    fi

    save_state editor \
        PATCHED 1 \
        PATCH_VERSION "$SCRIPT_VERSION" \
        UPSTREAM_VERSION "$version" \
        ORIGINAL_IMAGE "$current" \
        BACKUP_IMAGE "$backup" \
        PATCH_IMAGE "$image" \
        COMPOSE_FILE "$compose" \
        WORKING_DIR "$dir" \
        SERVICE "$service" \
        PANEL_ORIGIN "$panel_origin"

    ok "Xray UI Editor пропатчен."
}

install_panel_patch() {
    local editor_url="${1:-}"
    local password="${2:-}"
    local panel_url="${3:-}"
    local version dir compose service env_file current backup image source

    [[ -n "$PANEL_CONTAINER" ]] || die "Remnawave не найдена."
    [[ -z "$PANEL_PATCH_VERSION" ]] || die "Remnawave уже пропатчена."

    version="$PANEL_VERSION"
    [[ "$version" != "неизвестна" && "$version" != "не найдена" ]] \
        || die "Не удалось определить версию Remnawave."

    log "Проверяю совместимость Remnawave $version…"
    check_patch_compatibility_panel "$version" \
        || die "Remnawave $version несовместима с патчем $SCRIPT_VERSION."

    if [[ -z "$editor_url" ]]; then
        editor_url="$(prompt_value \
            "HTTPS URL Xray UI Editor" \
            "https://editor.example.com")"
    fi
    editor_url="$(validate_url_origin "$editor_url")" \
        || die "Нужен URL вида https://editor.example.com без пути."

    if [[ -z "$password" ]]; then
        password="$(prompt_secret "APP_PASSWORD удалённого Xray UI Editor")"
    fi
    [[ -n "$password" ]] || die "Пароль пуст."

    if [[ -z "$panel_url" ]]; then
        panel_url="$(prompt_value \
            "Публичный HTTPS URL панели для проверки" \
            "https://panel.example.com")"
    fi
    panel_url="$(validate_url_origin "$panel_url")" \
        || die "Нужен URL вида https://panel.example.com без пути."

    validate_editor_sso "$editor_url" "$password" \
        || die "Editor не принял SSO-запрос. Сначала пропатчите Xray UI Editor."

    dir="$(find_working_dir "$PANEL_CONTAINER" "$PANEL_DIR_DEFAULT")"
    compose="$(find_compose_file "$PANEL_CONTAINER" "$dir")" \
        || die "Compose Remnawave не найден."
    service="$(find_service_name "$PANEL_CONTAINER" remnawave)"
    env_file="$dir/.env"
    [[ -f "$env_file" ]] || die "Не найден $env_file"

    current="$(docker inspect "$PANEL_CONTAINER" --format '{{.Config.Image}}')"
    backup="$(backup_current_image remnawave "$PANEL_CONTAINER")"
    image="local/capyteam/rw-wasm-remnawave:${version}-patch-${SCRIPT_VERSION}"
    source="$BUILD_ROOT/remnawave-$version"

    download_panel_sources "$version" "$source"
    build_panel_image "$version" "$source" "$image"

    save_state remnawave \
        PATCHED 1 \
        PATCH_VERSION "$SCRIPT_VERSION" \
        UPSTREAM_VERSION "$version" \
        ORIGINAL_IMAGE "$current" \
        BACKUP_IMAGE "$backup" \
        PATCH_IMAGE "$image" \
        COMPOSE_FILE "$compose" \
        WORKING_DIR "$dir" \
        SERVICE "$service" \
        PANEL_URL "$panel_url" \
        EDITOR_URL "$editor_url"

    write_dotenv "$env_file" XRAY_EDITOR_URL "$editor_url"
    write_dotenv "$env_file" XRAY_EDITOR_PASSWORD "$password"
    replace_service_image "$compose" "$service" "$image"

    (
        cd "$dir"
        docker compose config >/dev/null
        docker compose up -d --force-recreate "$service"
    )

    wait_healthy "$PANEL_CONTAINER" 360
    restart_reverse_proxy

    if ! curl -kfsS \
        --connect-timeout 10 \
        --max-time 30 \
        "$panel_url/" >/dev/null; then
        warn "Контейнер healthy, но публичная проверка панели не прошла. Проверьте reverse proxy."
    fi

    check_frame_headers "$editor_url" "$panel_url" || true

    local panel_headers
    panel_headers="$(curl -skD- -o /dev/null \
        --connect-timeout 10 --max-time 30 "$panel_url/" || true)"
    if ! printf '%s\n' "$panel_headers" \
        | grep -i '^content-security-policy:' \
        | grep -Fq "$editor_url"; then
        warn "Публичный CSP панели не содержит frame-src $editor_url. Reverse proxy может заменять CSP приложения."
    fi

    save_state remnawave \
        PATCHED 1 \
        PATCH_VERSION "$SCRIPT_VERSION" \
        UPSTREAM_VERSION "$version" \
        ORIGINAL_IMAGE "$current" \
        BACKUP_IMAGE "$backup" \
        PATCH_IMAGE "$image" \
        COMPOSE_FILE "$compose" \
        WORKING_DIR "$dir" \
        SERVICE "$service" \
        PANEL_URL "$panel_url" \
        EDITOR_URL "$editor_url"

    ok "Remnawave пропатчена."
}

install_both_patch() {
    local panel_origin editor_url password

    panel_origin="$(prompt_value \
        "HTTPS origin панели Remnawave" \
        "https://panel.example.com")"
    panel_origin="$(validate_url_origin "$panel_origin")" \
        || die "Некорректный origin панели."

    editor_url="$(prompt_value \
        "HTTPS URL Xray UI Editor" \
        "https://editor.example.com")"
    editor_url="$(validate_url_origin "$editor_url")" \
        || die "Некорректный URL Editor."

    password="$(prompt_secret "APP_PASSWORD Xray UI Editor")"
    [[ -n "$password" ]] || die "Пароль пуст."

    install_editor_patch "$panel_origin" "$password"
    scan_environment
    install_panel_patch "$editor_url" "$password" "$panel_origin"
}


rollback_component() {
    local component="$1" mode="$2"
    local container version target compose dir service

    if [[ "$component" == "remnawave" ]]; then
        container="$PANEL_CONTAINER"
        version="$PANEL_VERSION"
    else
        container="$EDITOR_CONTAINER"
        version="$EDITOR_VERSION"
    fi

    [[ -n "$container" ]] || die "Компонент $component не найден."

    if ! load_state "$component"; then
        if [[ "$mode" == "full" && "$component" == "remnawave" ]]; then
            compose="$(find_compose_file "$container" "$PANEL_DIR_DEFAULT")" \
                || die "Compose Remnawave не найден."
            dir="$(find_working_dir "$container" "$PANEL_DIR_DEFAULT")"
            service="$(find_service_name "$container" remnawave)"
            target="$(official_panel_image "$version" \
                "$(docker inspect "$container" --format '{{.Config.Image}}')")"
            docker pull "$target"
        elif [[ "$mode" == "full" && "$component" == "editor" ]]; then
            compose="$(find_compose_file "$container" "$EDITOR_DIR_DEFAULT")" \
                || die "Compose Xray UI Editor не найден."
            dir="$(find_working_dir "$container" "$EDITOR_DIR_DEFAULT")"
            service="$(find_service_name "$container" remnawave-xray-ui-editor)"
            [[ "$version" != "неизвестна" && "$version" != "не найден" ]] \
                || die "Не удалось определить версию Editor для полного отката."
            local clean_source="$BUILD_ROOT/editor-clean-$version"
            target="local/capyteam/rw-wasm-editor-clean:${version}"
            download_editor_source "$version" "$clean_source"
            docker build --pull \
                --label "$LABEL_NS.component=editor-clean" \
                --label "$LABEL_NS.upstream-version=$version" \
                -t "$target" "$clean_source"
        else
            die "Нет state-файла с точным backup image для отката $component до бэкапа."
        fi
    else
        compose="$COMPOSE_FILE"
        dir="$WORKING_DIR"
        service="$SERVICE"

        if [[ "$mode" == "full" ]]; then
            if [[ "$component" == "remnawave" ]]; then
                target="$(official_panel_image "$version" "$ORIGINAL_IMAGE")"
                docker pull "$target"
            else
                target="$ORIGINAL_IMAGE"
                docker image inspect "$target" >/dev/null 2>&1 || docker pull "$target"
            fi
        else
            target="$BACKUP_IMAGE"
            docker image inspect "$target" >/dev/null 2>&1 \
                || die "Backup image $target отсутствует."
        fi
    fi

    replace_service_image "$compose" "$service" "$target"

    (
        cd "$dir"
        docker compose config >/dev/null
        docker compose up -d --force-recreate "$service"
    )

    wait_healthy "$container" 360

    if [[ "$component" == "remnawave" ]]; then
        restart_reverse_proxy
    fi

    archive_state "$component"
    ok "$component возвращён на image $target. БД, volumes и остальные настройки сохранены."
}

rollback_menu() {
    local components=()
    local selected=()
    local component_choice mode_choice component

    [[ -n "$PANEL_PATCH_VERSION" ]] && components+=("remnawave")
    [[ -n "$EDITOR_PATCH_VERSION" ]] && components+=("editor")

    if ((${#components[@]} == 0)); then
        warn "Установленный патч не найден."
        return
    fi

    if ((${#components[@]} == 2)); then
        printf '\n1) Remnawave\n'
        printf '2) Xray UI Editor\n'
        printf '3) Оба компонента\n'
        printf 'q) Отмена\n'
        read -r -p '> ' component_choice

        case "$component_choice" in
            1) selected=("remnawave") ;;
            2) selected=("editor") ;;
            3) selected=("editor" "remnawave") ;;
            *) return ;;
        esac
    else
        selected=("${components[0]}")
    fi

    printf '\n1) Полный откат — официальный/исходный image текущей версии\n'
    printf '2) Откат до бэкапа — точный image до установки патча\n'
    printf 'q) Отмена\n'
    read -r -p '> ' mode_choice

    case "$mode_choice" in
        1) mode_choice="full" ;;
        2) mode_choice="backup" ;;
        *) return ;;
    esac

    warn "Будут пересозданы только выбранные контейнеры. БД, Docker volumes, Compose и остальные сервисы не удаляются."
    confirm_yn "Продолжить откат?" || return

    for component in "${selected[@]}"; do
        rollback_component "$component" "$mode_choice"
        scan_environment
    done
}

update_script() {
    local body asset checksum_asset sums tmp self new_version tag_name expected actual

    body="$(release_field "$SCRIPT_RELEASE_FILE" body)"
    tag_name="$(release_field "$SCRIPT_RELEASE_FILE" tag_name)"

    printf '\n%bИзменения в %s:%b\n%s\n\n' \
        "$BOLD" "$tag_name" "$RESET" \
        "${body:-Описание релиза отсутствует.}"

    confirm_yn "Установить обновление скрипта?" || return

    asset="$(release_asset_url "$SCRIPT_RELEASE_FILE" rw-wasm)"
    if [[ -z "$asset" ]]; then
        asset="https://raw.githubusercontent.com/$SCRIPT_REPO/$tag_name/rw-wasm"
    fi

    tmp="$(mktemp)"
    curl -fsSL \
        --connect-timeout 10 \
        --max-time 120 \
        --retry 3 \
        "$asset" \
        -o "$tmp"

    checksum_asset="$(release_asset_url "$SCRIPT_RELEASE_FILE" SHA256SUMS)"
    if [[ -n "$checksum_asset" ]]; then
        sums="$(mktemp)"
        curl -fsSL \
            --connect-timeout 10 \
            --max-time 120 \
            --retry 3 \
            "$checksum_asset" \
            -o "$sums"
        expected="$(awk '$2 == "rw-wasm" || $2 == "*rw-wasm" {print $1; exit}' "$sums")"
        actual="$(sha256sum "$tmp" | awk '{print $1}')"
        rm -f "$sums"
        [[ -n "$expected" && "$actual" == "$expected" ]] \
            || die "SHA-256 загруженного rw-wasm не совпадает с SHA256SUMS релиза."
        ok "Контрольная сумма обновления подтверждена."
    else
        warn "В релизе нет SHA256SUMS; проверяется HTTPS GitHub и синтаксис Bash."
    fi

    chmod 755 "$tmp"
    bash -n "$tmp"

    new_version="$(grep -m1 '^SCRIPT_VERSION=' "$tmp" | cut -d'"' -f2)"
    [[ "$new_version" == "$SCRIPT_LATEST_VERSION" ]] \
        || die "Версия загруженного файла ($new_version) не совпадает с релизом ($SCRIPT_LATEST_VERSION)."

    self="$(readlink -f "$0")"
    install -m 0755 "$tmp" "${self}.new"
    mv -f "${self}.new" "$self"
    rm -f "$tmp"

    ok "Скрипт обновлён до $new_version."
    exec "$self"
}

clean_update_panel() {
    local version="$1"
    local dir compose service current target

    dir="$(find_working_dir "$PANEL_CONTAINER" "$PANEL_DIR_DEFAULT")"
    compose="$(find_compose_file "$PANEL_CONTAINER" "$dir")" \
        || die "Compose Remnawave не найден."
    service="$(find_service_name "$PANEL_CONTAINER" remnawave)"
    current="$(docker inspect "$PANEL_CONTAINER" --format '{{.Config.Image}}')"
    target="$(official_panel_image "$version" "$current")"

    log "Загружаю официальный image $target…"
    docker pull "$target"

    replace_service_image "$compose" "$service" "$target"

    (
        cd "$dir"
        docker compose config >/dev/null
        docker compose up -d --force-recreate "$service"
    )

    wait_healthy "$PANEL_CONTAINER" 480
    restart_reverse_proxy
    archive_state remnawave

    ok "Установлена чистая официальная Remnawave $version. БД и volumes сохранены."
}

patched_update_panel() {
    local version="$1"
    local dir env_file editor_url password panel_url

    dir="$(find_working_dir "$PANEL_CONTAINER" "$PANEL_DIR_DEFAULT")"
    env_file="$dir/.env"

    editor_url="$(read_dotenv "$env_file" XRAY_EDITOR_URL)"
    password="$(read_dotenv "$env_file" XRAY_EDITOR_PASSWORD)"
    panel_url=""

    if load_state remnawave 2>/dev/null; then
        panel_url="${PANEL_URL:-}"
    fi

    [[ -n "$editor_url" ]] \
        || editor_url="$(prompt_value "HTTPS URL Xray UI Editor" "https://editor.example.com")"
    [[ -n "$password" ]] \
        || password="$(prompt_secret "APP_PASSWORD Xray UI Editor")"
    [[ -n "$panel_url" ]] \
        || panel_url="$(prompt_value "Публичный HTTPS URL панели" "https://panel.example.com")"

    PANEL_PATCH_VERSION=""
    PANEL_VERSION="$version"

    install_panel_patch "$editor_url" "$password" "$panel_url"
}

update_panel_menu() {
    local choice

    if ((PANEL_LATEST_COMPATIBLE)); then
        printf '\n%bRemnawave %s поддерживается патчем %s.%b\n' \
            "$GREEN" "$PANEL_LATEST_VERSION" "$SCRIPT_VERSION" "$RESET"
        printf '1) Установить обновление с патчем\n'
        printf '2) Установить чистую официальную версию\n'
        printf 'q) Отмена\n'
        read -r -p '> ' choice

        case "$choice" in
            1)
                confirm_yn "Установить обновление с патчем?" \
                    && patched_update_panel "$PANEL_LATEST_VERSION"
                ;;
            2)
                confirm_yn "Установить чистую официальную версию?" \
                    && clean_update_panel "$PANEL_LATEST_VERSION"
                ;;
        esac
    else
        printf '\n%bВНИМАНИЕ: патч %s не совместим с Remnawave %s.%b\n' \
            "$RED" "$SCRIPT_VERSION" "$PANEL_LATEST_VERSION" "$RESET"
        printf 'Будет установлен чистый официальный image без изменений исходного кода.\n'

        confirm_yn "Продолжить обновление без патча?" \
            && clean_update_panel "$PANEL_LATEST_VERSION"
    fi
}

install_cli() {
    require_root

    local self target="${RW_WASM_INSTALL_PATH:-/usr/local/bin/rw-wasm}"
    self="$(readlink -f "$0")"

    if [[ "$self" != "$(readlink -f "$target" 2>/dev/null || printf '%s' "$target")" ]]; then
        install -m 0755 "$self" "$target"
    else
        chmod 0755 "$target"
    fi
    ok "Команда установлена: $target"
    printf 'Теперь меню открывается командой: rw-wasm\n'
}

main_menu() {
    local choice

    while true; do
        scan_environment
        show_menu
        read -r -p '> ' choice

        case "${choice,,}" in
            1)
                if [[ -n "$EDITOR_CONTAINER" && -z "$EDITOR_PATCH_VERSION" ]]; then
                    install_editor_patch
                else
                    warn "Пункт недоступен."
                fi
                pause
                ;;
            2)
                if [[ -n "$PANEL_CONTAINER" && -z "$PANEL_PATCH_VERSION" ]]; then
                    install_panel_patch
                else
                    warn "Пункт недоступен."
                fi
                pause
                ;;
            3)
                if [[ -n "$PANEL_CONTAINER" && -n "$EDITOR_CONTAINER" \
                    && -z "$PANEL_PATCH_VERSION" && -z "$EDITOR_PATCH_VERSION" ]]; then
                    install_both_patch
                else
                    warn "Пункт недоступен."
                fi
                pause
                ;;
            4)
                if [[ -n "$PANEL_PATCH_VERSION" || -n "$EDITOR_PATCH_VERSION" ]]; then
                    rollback_menu
                else
                    warn "Пункт недоступен."
                fi
                pause
                ;;
            5)
                if ((SCRIPT_UPDATE_AVAILABLE)); then
                    update_script
                else
                    warn "Обновление скрипта недоступно."
                    pause
                fi
                ;;
            6)
                if ((PANEL_UPDATE_AVAILABLE)); then
                    update_panel_menu
                    scan_environment
                    check_updates
                else
                    warn "Обновление Remnawave недоступно."
                fi
                pause
                ;;
            q)
                printf '%bДо встречи!%b\n' "$CYAN" "$RESET"
                exit 0
                ;;
            *)
                warn "Неизвестный пункт меню."
                sleep 1
                ;;
        esac
    done
}

case "${1:-}" in
    --version|-v)
        printf '%s %s\n' "$SCRIPT_NAME" "$SCRIPT_VERSION"
        exit 0
        ;;
    --install)
        require_root
        init_runtime
        install_cli
        exit 0
        ;;
    --offline)
        export RW_WASM_OFFLINE=1
        ;;
    --help|-h)
        cat <<EOF
$SCRIPT_NAME v$SCRIPT_VERSION

Использование:
  rw-wasm             открыть интерактивное меню
  rw-wasm --offline   открыть меню без проверки GitHub
  rw-wasm --install   установить команду /usr/local/bin/rw-wasm
  rw-wasm --version   показать версию
EOF
        exit 0
        ;;
esac

require_root
init_runtime
require_tools
scan_environment
log "Проверяю обновления и совместимость исходников…"
check_updates || warn "Проверка обновлений завершилась с ошибкой; локальные функции доступны."
main_menu
