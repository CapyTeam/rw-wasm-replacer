validate_url_origin() {
    local value="$1"
    python3 - "$value" <<'PY'
import sys
import urllib.parse

parsed = urllib.parse.urlparse(sys.argv[1])
if (
    parsed.scheme != "https"
    or not parsed.netloc
    or parsed.path not in ("", "/")
    or parsed.query
    or parsed.fragment
):
    raise SystemExit(1)

print(f"{parsed.scheme}://{parsed.netloc}")
PY
}

validate_editor_sso() {
    local url="$1" password="$2" response code
    response="$(mktemp)"

    code="$({
        SSO_PASSWORD="$password" python3 <<'PY'
import json
import os

print(json.dumps({
    "password": os.environ["SSO_PASSWORD"],
    "next": "/profiles/00000000-0000-0000-0000-000000000000",
}))
PY
    } | curl -sS \
        --connect-timeout 10 \
        --max-time 30 \
        -o "$response" \
        -w '%{http_code}' \
        -H 'Content-Type: application/json' \
        --data-binary @- \
        "$url/api/auth/sso/token" || true)"

    if [[ "$code" != "200" ]] || ! grep -q '"token"' "$response"; then
        cat "$response" >&2 || true
        rm -f "$response"
        return 1
    fi

    rm -f "$response"
}


editor_local_url() {
