from pathlib import Path
import os

root = Path(os.environ["EDITOR_SRC"])

def require(path: Path, needle: str) -> str:
    text = path.read_text(encoding="utf-8")
    if needle not in text:
        raise SystemExit(f"Не найден контрольный фрагмент в {path}: {needle!r}")
    return text

(root / "backend/src/auth/sso.ts").write_text(r'''import { createHmac, randomBytes, timingSafeEqual } from 'node:crypto'
import type { FastifyInstance, FastifyReply } from 'fastify'
import { z } from 'zod'

import type { AppConfig } from '../config.js'
import { verifyPassword } from './password.js'
import { SESSION_COOKIE } from './session.js'

const TOKEN_TTL_SECONDS = 90

const profilePath = z
  .string()
  .regex(
    /^\/profiles\/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i,
    'Разрешён только путь профиля',
  )

const createTokenSchema = z.object({
  password: z.string().min(1),
  next: profilePath,
})

const consumeTokenSchema = z.object({
  token: z.string().min(40).max(4096),
})

const payloadSchema = z.object({
  next: profilePath,
  exp: z.number().int().positive(),
  nonce: z.string().min(16).max(128),
})

type SsoPayload = z.infer<typeof payloadSchema>

function sign(encodedPayload: string, secret: string): string {
  return createHmac('sha256', secret).update(encodedPayload).digest('base64url')
}

function makeToken(payload: SsoPayload, secret: string): string {
  const encodedPayload = Buffer.from(JSON.stringify(payload), 'utf8').toString('base64url')
  return `${encodedPayload}.${sign(encodedPayload, secret)}`
}

function readToken(token: string, secret: string): SsoPayload | null {
  const parts = token.split('.')
  if (parts.length !== 2) return null

  const [encodedPayload, suppliedSignature] = parts
  const expectedSignature = sign(encodedPayload, secret)
  const supplied = Buffer.from(suppliedSignature)
  const expected = Buffer.from(expectedSignature)

  if (supplied.length !== expected.length || !timingSafeEqual(supplied, expected)) {
    return null
  }

  try {
    const payload = payloadSchema.parse(
      JSON.parse(Buffer.from(encodedPayload, 'base64url').toString('utf8')),
    )
    if (payload.exp <= Math.floor(Date.now() / 1000)) return null
    return payload
  } catch {
    return null
  }
}

function setSessionCookie(reply: FastifyReply, config: AppConfig): void {
  reply.setCookie(SESSION_COOKIE, String(Date.now()), {
    signed: true,
    httpOnly: true,
    sameSite: 'none',
    secure: true,
    path: '/',
    maxAge: config.sessionTtlSeconds,
  })
}

export async function registerSsoRoutes(app: FastifyInstance, config: AppConfig): Promise<void> {
  app.post(
    '/api/auth/sso/token',
    { config: { rateLimit: { max: 20, timeWindow: '1 minute' } } },
    async (req, reply) => {
      const { password, next } = createTokenSchema.parse(req.body)
      if (!(await verifyPassword(password, config.appPassword))) {
        return reply.status(401).send({ message: 'Неверный пароль' })
      }

      const now = Math.floor(Date.now() / 1000)
      const token = makeToken(
        {
          next,
          exp: now + TOKEN_TTL_SECONDS,
          nonce: randomBytes(18).toString('base64url'),
        },
        config.sessionSecret,
      )

      reply.header('Cache-Control', 'no-store')
      return { token, expiresIn: TOKEN_TTL_SECONDS }
    },
  )

  app.get(
    '/api/auth/sso/consume',
    { config: { rateLimit: { max: 60, timeWindow: '1 minute' } } },
    async (req, reply) => {
      const { token } = consumeTokenSchema.parse(req.query)
      const payload = readToken(token, config.sessionSecret)

      if (!payload) {
        return reply.status(401).send({ message: 'SSO-токен недействителен или истёк' })
      }

      reply.header('Cache-Control', 'no-store')
      reply.header('Referrer-Policy', 'no-referrer')
      setSessionCookie(reply, config)
      return reply.redirect(payload.next)
    },
  )
}
''', encoding="utf-8")

